<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.br.taskmanager.controllers.TarefaFormController"
      spacing="8" prefWidth="440" styleClass="formulario">

    <Label fx:id="labelTituloTela" text="Nova tarefa" styleClass="titulo-form"/>
    <Region prefHeight="6"/>

    <Label text="Título"/>
    <TextField fx:id="campoTitulo" promptText="Ex.: Estudar generics"/>

    <Label text="Descrição"/>
    <TextArea fx:id="campoDescricao" prefRowCount="5" wrapText="true" promptText="Opcional"/>

    <CheckBox fx:id="checkConcluida" text="Tarefa concluída" visible="false" managed="false"/>

    <Label fx:id="labelErro" styleClass="erro" wrapText="true" visible="false" managed="false"/>

    <Region prefHeight="6"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" cancelButton="true" onAction="#cancelar"/>
        <Button text="Salvar" defaultButton="true" onAction="#salvar" styleClass="botao-principal"/>
    </HBox>
</VBox>
