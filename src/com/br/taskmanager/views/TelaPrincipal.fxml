<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.br.taskmanager.controllers.TelaPrincipalController"
            styleClass="raiz">

    <top>
        <VBox styleClass="cabecalho">
            <Label text="TaskManager" styleClass="titulo-app"/>
            <Label text="Organize suas tarefas de forma simples." styleClass="texto-secundario"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="conteudo">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Mostrar"/>
                <ComboBox fx:id="comboFiltro"/>
                <Label text="Ordenar por"/>
                <ComboBox fx:id="comboOrdenacao"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="labelResumo" styleClass="texto-secundario"/>
            </HBox>

            <ListView fx:id="listaTarefas" VBox.vgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="+ Nova tarefa" onAction="#novaTarefa" styleClass="botao-principal"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botaoEditar" text="Editar" onAction="#editarTarefa"/>
                <Button fx:id="botaoAlternarStatus" text="Concluir" onAction="#alternarStatus"/>
                <Button fx:id="botaoRemover" text="Remover" onAction="#removerTarefa" styleClass="botao-perigo"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
